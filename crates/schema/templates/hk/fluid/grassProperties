FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      grassProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

grassModel  simpleGrass;

simpleGrassCoeffs
{
    grassPatches
    (
        ground_grass
    );

    Cd 0.2;
    LAI 2;
    nEvapSides 1;
    beta 0.5;
    albedoSoil 0.2;
    rs 400;
}

// Number of flow iterations per grass iteration
solverFreq 3;//1;

