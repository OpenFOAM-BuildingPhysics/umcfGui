FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }

    "(U|k|epsilon|w)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0.01;
    }
    "(h|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0.01;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    pMaxFactor               1.2;
    pMinFactor               0.8;

    residualControl
    {
        p_rgh           1e-2;
        U               1e-5;
        "(h|e)"         1e-5;
        w               1e-4;
        "(k|epsilon|omega)" 1e-5;
        Tl 1e-4;
        Tg 1e-4;
    }
}

relaxationFactors
{
    Tl  0.3;
    Tg  0.3;
    fields
    {
        p_rgh           0.3;//0.5;
    }
    equations
    {
        U               0.3;
        "(T|h|e)"       0.3;
        k               0.3;
        epsilon         0.3;
        w               0.5;
    }
}


