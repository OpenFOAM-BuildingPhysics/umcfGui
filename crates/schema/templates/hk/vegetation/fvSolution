FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh                                  
    {
        solver           GAMG;
        tolerance        1e-9;
        relTol           0.1;

        smoother         DICGaussSeidel;

        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator     faceAreaPair;
        mergeLevels      1;

        maxIter          100;
    }

    "(U|k|epsilon|w)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0.1;
    }
    "(h|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1;//1e-12;
        relTol          0;//0.1;
        minIter         0;//1;
        maxIter         100;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    rhoMax          rhoMax [ 1 -3 0 0 0 ] 1.5;
    rhoMin          rhoMin [ 1 -3 0 0 0 ] 0.9;

    residualControl
    {
        p_rgh           1e-2;
        U               2e-4;
        h               1e-4;
        w               1e-4;
        "(k|epsilon|omega)" 1e-3;
    }
}

relaxationFactors
{
    fields
    {
        rho             1.0;
        p_rgh           0.7;//0.3;
    }
    equations
    {
        U               0.3;//0.3;
        "(h|e)"         0.7;//0.5;
        k               0.5;
        epsilon         0.5;
		w				0.7;
    }
}


